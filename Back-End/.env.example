# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# HTTP port for the API server (default 3000).
PORT="3000"

# Secret used to sign and verify JWT bearer tokens (any long random string).
JWT_SECRET="change-me-to-a-long-random-string"

# Redis (in-memory write-back cache for live GPS positions).
# If unreachable, the backend falls back to an in-process cache automatically.
REDIS_URL="redis://localhost:6379"

# Seconds a live position stays in the cache without a refresh.
LIVE_TTL_SECONDS="60"

# How often (ms) the write-back flusher persists the live cache to PostgreSQL.
TELEMETRY_FLUSH_MS="15000"

# MapTiler API key (used server-side for geocoding, reverse geocoding and static maps).
# Get one at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=""

# MapTiler map style used for tiles + static images (optional, default: streets-v2).
MAPTILER_STYLE_ID="streets-v2"

# ---------------------------------------------------------------------------
# Email alerts (incident notifications to transport managers)
# ---------------------------------------------------------------------------
# SMTP credentials for outgoing incident alert emails.
# The free options are Gmail (app password) or Brevo. See README for setup.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Must be a verified sender (for Gmail simply your own address).
MAIL_FROM="Transit Alerts <your-email@gmail.com>"

# ---------------------------------------------------------------------------
# Anomaly engine thresholds (Phase 3)
# ---------------------------------------------------------------------------
# Metres off the route corridor before a ROUTE_DEVIATION is raised.
ANOMALY_DEVIATION_METERS="300"
# Seconds stationary outside a designated stop before UNANTICIPATED_STOP.
ANOMALY_STOP_SECONDS="180"
# Speed (km/h) at or below which the vehicle is considered stopped.
ANOMALY_STOP_SPEED_KMH="2"
# Deceleration (km/h) within the window below that counts as an ACCIDENT.
ANOMALY_ACCIDENT_DECEL_KMH="40"
ANOMALY_ACCIDENT_WINDOW_MS="10000"
# Minimum ms between anomaly evaluations per device (throttle).
ANOMALY_EVAL_MS="3000"
# Seconds the allowed-track / route-stop cache lives in Redis.
ROUTE_CACHE_TTL_SECONDS="300"
# Suppress duplicate OPEN incidents of the same type per bus for this long.
INCIDENT_COOLDOWN_MS="120000"

# ---------------------------------------------------------------------------
# Incident dispatch (Phase 4)
# ---------------------------------------------------------------------------
# How many nearest responders to alert per incident.
DISPATCH_MAX_RESPONDERS="3"
# Set to "false" to disable auto-dispatch (incidents still recorded and emailed).
DISPATCH_ENABLED="true"

# ---------------------------------------------------------------------------
# Driver session hardening (Phase 6)
# ---------------------------------------------------------------------------
# When true (default), a driver session code can be used only once; the device id
# is pinned into the issued JWT. Set "false" for repeat logins during testing.
SESSION_SINGLE_USE="true"

# ---------------------------------------------------------------------------
# Optional: live traffic provider for congestion classification
# ---------------------------------------------------------------------------
# MapTiler (free) has no live traffic API, so congestion classification uses a
# heuristic by default. If you later add a free TomTom developer key, the
# anomaly engine will use it for real traffic speeds.
TOMTOM_API_KEY=""
