# Copy this file to `.env` and replace the placeholder with your real connection string.
# Connection string for PostgreSQL.
# Requires PostgreSQL >= 15.

DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# HTTP port for the API server (default 3000).
PORT="3000"

# Secret used to sign and verify JWT bearer tokens (any long random string).
JWT_SECRET="change-me-to-a-long-random-string"

# Driver session codes: how long a code stays valid, and how often the
# background sweeper removes expired unused codes.
SESSION_TTL_MINUTES="10"
SESSION_SWEEP_MS="60000"

# Redis connection (shared cache). If unreachable, the backend falls back to
# an in-process memory cache automatically.
REDIS_URL="redis://localhost:6379"

# Default TTL (seconds) for generic cached values.
CACHE_TTL_SECONDS="60"

# How long the latest GPS position for a bus stays in Redis without a refresh.
LIVE_TTL_SECONDS="60"

# How long a streaming claim stays valid without a new ping.
STREAM_TTL_SECONDS="30"

# Route corridor and test-only deviation evaluation.
CORRIDOR_WIDTH_METERS="300"
DEVIATION_CONSECUTIVE_PINGS="3"
PROGRESS_BACKTRACK_THRESHOLD="0.01"

# MapTiler API key (used server-side for geocoding, reverse geocoding and static maps).
# Get one at https://cloud.maptiler.com/account/keys/
MAPTILER_API_KEY=""

# MapTiler map style used for tiles + static images (optional, default: streets-v2).
MAPTILER_STYLE_ID="streets-v2"

# ---------------------------------------------------------------------------
# Email alerts (incident notifications to transport managers)
# ---------------------------------------------------------------------------
# SMTP credentials for outgoing incident alert emails.
# The free options are Gmail (app password) or Brevo. See README for setup.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
# Must be a verified sender (for Gmail simply your own address).
MAIL_FROM="Transit Alerts <your-email@gmail.com>"

# ---------------------------------------------------------------------------
# Incident handling and dispatch
# ---------------------------------------------------------------------------
# Suppress duplicate OPEN incidents of the same type per bus for this long.
INCIDENT_COOLDOWN_MS="120000"
# How many nearest responders to alert per incident.
DISPATCH_MAX_RESPONDERS="3"
# Set to "false" to disable auto-dispatch (incidents still recorded and emailed).
DISPATCH_ENABLED="true"

