# Backend API base URL.
VITE_API_URL="http://localhost:3000"

# Backend port used when auto-detecting the host on a phone over the LAN
# (must match Back-End PORT). Default 3000.
VITE_API_PORT="3000"

# MapTiler API key (browser-scoped) used to render the live map (vector tiles).
# Get one at https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=""

# MapTiler map style for the live map (optional, default: streets-v2).
VITE_MAPTILER_STYLE_ID="streets-v2"